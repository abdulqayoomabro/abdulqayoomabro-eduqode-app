<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 so the offline screens get modern buttons, cards and progress bars. Same brand colours as before. -->
    <style name="Theme.EduQode" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/brand_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/brand_dark</item>
        <item name="colorSecondaryContainer">@color/brand_accent_soft</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:colorBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="toolbarStyle">@style/Widget.EduQode.Toolbar</item>
    </style>

    <style name="Widget.EduQode.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/brand_dark</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="subtitleTextColor">#CCFFFFFF</item>
        <item name="navigationIconTint">@android:color/white</item>
    </style>

    <style name="ThemeOverlay.EduQode.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@android:color/white</item>
    </style>

    <style name="Widget.EduQode.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#33F5A623</item>
    </style>

    <style name="Theme.EduQode.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.EduQode</item>
    </style>

    <style name="TextAppearance.EduQode.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>

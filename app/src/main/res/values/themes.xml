<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EduQode" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_dark</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.EduQode.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.EduQode</item>
    </style>
</resources>
